{"version":"1","base":"/api","auth":{"GET /auth/me":"Returns {user: null|{id,name,email,role},csrf_token}; send X-CSRF-Token for EVERY write including login. Cookie session credentials same-origin.","POST /auth/login":{"body":{"email":"string","password":"string"},"response":"{user,csrf_token}"},"POST /auth/logout":"{}"},"endpoints":{"GET /health":"public","GET /dashboard/summary":"{total_students,total_predictions,risk_distribution:{low,medium,high},class_distribution,priority_students,trend,intervention_status,active_models}","GET /students":"{items:[{student_id,cohort,program_code,active_status,latest_prediction}],total} query q,cohort,program_code,stage,risk_band,predicted_class,page,per_page","POST /students":"admin {student_id,cohort,program_code,advisor_id?}","GET /students/{id}/timeline":"{student,predictions,interventions}","GET /model-schemas/{stage}/active":"{stage,schema_version,model_version,features:[{name,label,type,required,min,max,categories?,observed_min,observed_max}],example}","GET /templates/{stage}.csv":"download CSV","POST /predictions":"{student_id,stage,snapshot_date,features:{exact feature names:numbers},schema_version?,idempotency_key?} returns prediction object","GET /predictions/{id}":"prediction object {id,prediction_id,student_id,stage,snapshot_date,predicted_class,probabilities,risk_band,model_version,schema_version,created_at,top_drivers,top_protectors,explanation,features,disclaimer,warnings}","POST /assistant":"{prediction_id,intent:why|intervention|changes|confidence,question?} returns {answer,suggestions,disclaimer}","POST /interventions":"{student_id,prediction_id?,type,note,due_date,status:planned|in_progress|completed}","PATCH /interventions/{id}":"{status,note?,due_date?}","POST /batch-jobs":"multipart file + stage; returns job {id,status:validated,valid_count,invalid_count,errors,preview}","POST /batch-jobs/{id}/run":"{} returns {id,status:queued}","GET /batch-jobs":"{items}","GET /batch-jobs/{id}":"job with results and errors","GET /batch-jobs/{id}/export":"results CSV; ?errors=1 for error CSV","GET /reports/export":"scoped predictions CSV same filters as students","GET /admin/users":"{items}","POST /admin/users":"{name,email,password,role:admin|advisor}","PATCH /admin/users/{id}":"{name?,role?,status:active|disabled?,password?}","GET /admin/assignments":"{items}","POST /admin/assignments":"{advisor_id,student_id}","DELETE /admin/assignments/{advisor_id}/{student_id}":"{}","GET /admin/model-versions":"{items} each {id,stage,algorithm,status,experimental,metrics,created_at}","POST /admin/model-versions/{id}/promote":"{reason} experimental rejected","POST /admin/model-versions/{id}/rollback":"{reason} previously promoted only","GET /admin/model-versions/{id}":"model details with metrics schema global_shap model_card","POST /admin/sandbox/predict":"{model_version,features} admin only allows experimental","GET /admin/training-jobs":"{items}","POST /admin/training-jobs":"{stage:intake|academic_update|both,seed?:42} fixed public source dataset; returns {id,status}","GET /admin/training-jobs/{id}":"{id,status,progress,result,error}","POST /admin/training-jobs/{id}/cancel":"{}","GET /admin/audit":"{items,total}","GET /admin/audit/export":"CSV","GET /admin/thresholds":"{version,medium,high}","POST /admin/thresholds":"{medium,high,reason}","GET /admin/references":"{items}","PUT /admin/references":"{feature,code,label}"},"errors":"JSON {error,details?}; 400 validation,401 unauthenticated,403 forbidden/CSRF,404 missing,409 conflict,429 rate limit,503 model unavailable","notes":["stage intake = 24; academic_update = 36. Original UCI feature headers preserved including parentheses; strip trailing whitespace.","All list responses items. Passwords only private data/demo-credentials.txt.","Prototype Portugal UCI; SHAP noncausal; no automated sanctions."]}